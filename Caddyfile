# Mercure hub with the MongoDB transport.
#
# This is the default configuration of the ghcr.io/gromnan/mercure-mongodb
# image. It reads the MongoDB connection string and the JWT keys from the
# environment.
#
# Required environment variables:
#   MERCURE_MONGODB_URI         MongoDB connection string, on a replica set
#   MERCURE_PUBLISHER_JWT_KEY   publisher JWT key
#   MERCURE_SUBSCRIBER_JWT_KEY  subscriber JWT key
#
# Optional environment variables:
#   SERVER_NAME                 public address (default: localhost)
#   MERCURE_TRUSTED_ISSUERS     trusted issuer identifier (default: https://localhost)
#   MERCURE_MONGODB_DATABASE    database name (default: mercure)
#   MERCURE_MONGODB_COLLECTION  events collection (default: updates)
#   MERCURE_MONGODB_RETENTION   number of newest updates kept (default: 10000)
#   MERCURE_PUBLISHER_JWT_ALG   publisher JWT algorithm (default: HS256)
#   MERCURE_SUBSCRIBER_JWT_ALG  subscriber JWT algorithm (default: HS256)
{
	{$GLOBAL_OPTIONS}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	mercure {
		# Store updates in MongoDB and sync every hub instance through it.
		transport mongodb {
			uri {$MERCURE_MONGODB_URI}
			database {$MERCURE_MONGODB_DATABASE:mercure}
			collection {$MERCURE_MONGODB_COLLECTION:updates}
			retention {$MERCURE_MONGODB_RETENTION:10000}
		}

		# Trusted issuer: binds the iss claim access tokens must carry (RFC 9068)
		# to its verification keys. The localhost default suits local development
		# only. In production set MERCURE_TRUSTED_ISSUERS to the stable identifier
		# of your token issuer. Add more `issuer` blocks with
		# MERCURE_EXTRA_DIRECTIVES to trust several issuers.
		issuer {$MERCURE_TRUSTED_ISSUERS:https://localhost} {
			# Publisher JWT key.
			publisher {
				jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
			}

			# Subscriber JWT key.
			subscriber {
				jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
			}
		}

		{$MERCURE_EXTRA_DIRECTIVES}
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	log_skip /robots.txt
	log_skip /favicon.ico

	header / Content-Type "text/html; charset=utf-8"
	respond / `<!DOCTYPE html>
<html lang=en>
<meta charset="utf-8">
<title>Welcome to Mercure</title>
<h1>Welcome to Mercure</h1>
<p>The URL of your hub is <code>/.well-known/mercure</code>.
Read the documentation on <a href="https://mercure.rocks">Mercure.rocks, real-time apps made easy</a>.`
	respond /robots.txt `User-agent: *
Disallow: /`
	respond "Not Found" 404
}
