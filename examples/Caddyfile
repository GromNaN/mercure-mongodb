# Mercure hub using MongoDB as its only shared service.
#
# Run with a Caddy build that includes the mercure handler and this transport:
#   xcaddy build \
#     --with github.com/dunglas/mercure/caddy \
#     --with github.com/GromNaN/mercure-mongodb
{
	admin off
}

http://localhost:3000 {
	mercure {
		# Store updates in MongoDB and sync every hub instance through it.
		transport mongodb {
			uri {$MERCURE_MONGODB_URI}
			database mercure
			collection updates
			# Keep the 10000 newest updates. 0 keeps everything.
			retention 10000
		}

		# Trusted issuer: binds the iss claim access tokens must carry (RFC 9068)
		# to its verification keys. Add more `issuer` blocks to trust several
		# issuers.
		issuer http://localhost:3000 {
			publisher {
				jwt {env.MERCURE_PUBLISHER_JWT_KEY} HS256
			}
			subscriber {
				jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} HS256
			}
		}
	}
}
